# Scoped tokens only. Never a login password.
# Ask for the narrowest permission that does the job, and revoke anything you no longer use.

# Cloudflare Pages - create at dash.cloudflare.com > My Account > API Tokens,
# template "Edit Cloudflare Workers"/scope: Account - Cloudflare Pages - Edit.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Amazon PA-API - only after Amazon grants API access (needs qualifying sales).
PA_API_ACCESS_KEY=
PA_API_SECRET_KEY=
PA_API_PARTNER_TAG=

# Pinterest - OAuth from your own developer app. Run `node pinterest-auth.mjs`
# after filling the two keys below; it writes the tokens back into this file.
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_ACCESS_TOKEN=
PINTEREST_REFRESH_TOKEN=
PINTEREST_TOKEN_EXPIRES_AT=
